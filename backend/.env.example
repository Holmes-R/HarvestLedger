# Copy to backend/.env and replace the password with a local-only credential.
# Never put reviewer or hosted database credentials in this file.
PGDATABASE=harvestledger_dev
PGTESTDATABASE=harvestledger_test
PGUSER=harvestledger_local
PGPASSWORD=replace-with-local-password
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=disable
PGCHANNELBINDING=disable
