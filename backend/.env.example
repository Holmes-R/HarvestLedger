# Copy to backend/.env and replace the password with a local-only credential.
# Never put reviewer or hosted database credentials in this file.
SECRET_KEY=replace-with-a-long-random-local-only-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PGDATABASE=harvestledger_dev
PGTESTDATABASE=harvestledger_test
PGUSER=harvestledger_local
PGPASSWORD=replace-with-local-password
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=disable
PGCHANNELBINDING=disable

# Hosted Render/Neon deployment uses DEBUG=false, its own strong SECRET_KEY,
# explicit Render host/origins, and PGSSLMODE=require / PGCHANNELBINDING=require.
# Set hosted values in Render's secret environment, never in this local file.

# Reviewer clock aid (demo-only; see README section 10). Leave disabled and
# blank in production. Set ALLOW_REVIEW_CLOCK=true and a secret REVIEW_CLOCK_KEY
# only for a hosted demo, then send X-Test-Clock (ISO-8601, tz-aware) together
# with the matching X-Review-Key. Never commit a real key.
ALLOW_REVIEW_CLOCK=false
REVIEW_CLOCK_KEY=
