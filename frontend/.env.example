# Base URL of the HarvestLedger API (M3, mounted under /api/v1/).
# Copy this file to `.env` for local development. The value below is the
# default Django development server; the Vite dev origin is already allowed by
# the backend CORS configuration. Include /api/v1 exactly once: endpoint paths
# start with /, and the client joins API_BASE + endpoint path after stripping a
# trailing slash. Hosted example: https://YOUR-API.onrender.com/api/v1
#
# NEVER put database credentials or the reviewer-clock key here. Any VITE_*
# value is compiled into the public frontend bundle. The demo reviewer-clock
# key is entered at runtime in the UI and is never persisted in build output.
VITE_API_BASE_URL=http://localhost:8000/api/v1
